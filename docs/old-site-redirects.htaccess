# Permanent (301) redirects from the old WordPress site (xcosmeticsurgery.com)
# to the matching page on the new site (ycosmeticsurgery.com).
#
# HOW TO USE
#   In Bluehost's File Manager, open the old site's folder (public_html), edit the
#   file named ".htaccess", and paste everything below at the very TOP of the file,
#   above the line "# BEGIN WordPress". Save.
#
# After this, every address on the old domain goes to the new site, including the
# WordPress admin. To undo, delete this block from .htaccess in File Manager.
# These redirects only work while the Bluehost hosting plan is active.

RewriteEngine On

# --- Procedures
RewriteRule ^brazilian-butt-lift/?$    https://ycosmeticsurgery.com/procedures/brazilian-butt-lift [R=301,L]
RewriteRule ^tummy-tuck/?$             https://ycosmeticsurgery.com/procedures/tummy-tuck [R=301,L]
RewriteRule ^lipo-360-2/?$             https://ycosmeticsurgery.com/procedures/lipo-360 [R=301,L]
RewriteRule ^breast-augementation/?$   https://ycosmeticsurgery.com/procedures/breast-augmentation [R=301,L]
RewriteRule ^understanding-chin-liposuction-what-you-need-to-know/?$ https://ycosmeticsurgery.com/procedures/lipo-360 [R=301,L]
RewriteRule ^services/?$               https://ycosmeticsurgery.com/procedures [R=301,L]
RewriteRule ^special-offers/?$         https://ycosmeticsurgery.com/procedures [R=301,L]

# --- Galleries
RewriteRule ^photo-gallery/?$                https://ycosmeticsurgery.com/gallery [R=301,L]
RewriteRule ^category/gallery/?$             https://ycosmeticsurgery.com/gallery [R=301,L]
RewriteRule ^bbl-gallery/?$                  https://ycosmeticsurgery.com/gallery?category=Body [R=301,L]
RewriteRule ^tummy-tuck-gallery/?$           https://ycosmeticsurgery.com/gallery?category=Body [R=301,L]
RewriteRule ^lipo-360-gallery/?$             https://ycosmeticsurgery.com/gallery?category=Body [R=301,L]
RewriteRule ^breast-augmentation-gallery/?$  https://ycosmeticsurgery.com/gallery?category=Breast [R=301,L]

# --- About / contact
RewriteRule ^dr-mario-e-reyes/?$    https://ycosmeticsurgery.com/about [R=301,L]
RewriteRule ^category/doctors/?$    https://ycosmeticsurgery.com/about [R=301,L]
RewriteRule ^contact/?$             https://ycosmeticsurgery.com/contact [R=301,L]
RewriteRule ^consults/?$            https://ycosmeticsurgery.com/contact [R=301,L]
RewriteRule ^evaluation/?$          https://ycosmeticsurgery.com/contact [R=301,L]
RewriteRule ^financing-options/?$   https://ycosmeticsurgery.com/financing [R=301,L]
RewriteRule ^out-of-town/?$         https://ycosmeticsurgery.com/out-of-town-patients [R=301,L]
RewriteRule ^privacy-policy/?$       https://ycosmeticsurgery.com/privacy-policy [R=301,L]
RewriteRule ^terms-and-conditions/?$ https://ycosmeticsurgery.com/terms [R=301,L]

# --- Home page and everything else on the old domain
RewriteRule ^ https://ycosmeticsurgery.com/ [R=301,L]
