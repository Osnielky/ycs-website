# Permanent (301) redirects from the old WordPress site (xcosmeticsurgery.com)
# to the matching page on the new site (ycosmeticsurgery.com).
#
# HOW TO USE
#   Option A (Apache hosting): paste everything below at the TOP of the old site's
#   .htaccess file, above the "# BEGIN WordPress" block.
#   Option B (no file access): install the free "Redirection" WordPress plugin and
#   add each pair below as Source URL -> Target URL, type 301.
#
# Keep the old domain registered and these redirects in place for at least a year.
# Pages marked (*) have no equivalent on the new site yet; they point to the closest
# page for now and should be re-pointed once the new page exists.

RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?xcosmeticsurgery\.com$ [NC]

# --- Procedures
RedirectMatch 301 ^/brazilian-butt-lift/?$   https://ycosmeticsurgery.com/procedures/brazilian-butt-lift
RedirectMatch 301 ^/tummy-tuck/?$            https://ycosmeticsurgery.com/procedures/tummy-tuck
RedirectMatch 301 ^/lipo-360-2/?$            https://ycosmeticsurgery.com/procedures/lipo-360
RedirectMatch 301 ^/breast-augementation/?$  https://ycosmeticsurgery.com/procedures/breast-augmentation
RedirectMatch 301 ^/services/?$              https://ycosmeticsurgery.com/procedures
RedirectMatch 301 ^/understanding-chin-liposuction-what-you-need-to-know/?$  https://ycosmeticsurgery.com/procedures/lipo-360

# --- Galleries
RedirectMatch 301 ^/photo-gallery/?$               https://ycosmeticsurgery.com/gallery
RedirectMatch 301 ^/bbl-gallery/?$                 https://ycosmeticsurgery.com/gallery?category=Body
RedirectMatch 301 ^/tummy-tuck-gallery/?$          https://ycosmeticsurgery.com/gallery?category=Body
RedirectMatch 301 ^/lipo-360-gallery/?$            https://ycosmeticsurgery.com/gallery?category=Body
RedirectMatch 301 ^/breast-augmentation-gallery/?$ https://ycosmeticsurgery.com/gallery?category=Breast
RedirectMatch 301 ^/category/gallery/?$            https://ycosmeticsurgery.com/gallery

# --- About / contact
RedirectMatch 301 ^/dr-mario-e-reyes/?$   https://ycosmeticsurgery.com/about
RedirectMatch 301 ^/category/doctors/?$   https://ycosmeticsurgery.com/about
RedirectMatch 301 ^/contact/?$            https://ycosmeticsurgery.com/contact
RedirectMatch 301 ^/consults/?$           https://ycosmeticsurgery.com/contact
RedirectMatch 301 ^/evaluation/?$         https://ycosmeticsurgery.com/contact

# --- (*) No equivalent on the new site yet
RedirectMatch 301 ^/financing-options/?$     https://ycosmeticsurgery.com/contact
RedirectMatch 301 ^/out-of-town/?$           https://ycosmeticsurgery.com/contact
RedirectMatch 301 ^/special-offers/?$        https://ycosmeticsurgery.com/procedures
RedirectMatch 301 ^/blog/?$                  https://ycosmeticsurgery.com/
RedirectMatch 301 ^/privacy-policy/?$        https://ycosmeticsurgery.com/
RedirectMatch 301 ^/terms-and-conditions/?$  https://ycosmeticsurgery.com/
RedirectMatch 301 ^/manage-subscriptions/?$  https://ycosmeticsurgery.com/

# --- Home, and anything not listed above
RedirectMatch 301 ^/?$   https://ycosmeticsurgery.com/
RedirectMatch 301 ^/.*$  https://ycosmeticsurgery.com/
